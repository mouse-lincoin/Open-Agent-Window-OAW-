# OAW 环境变量示例。复制为 .env 后按需修改。

# ---------- API (apps/api) ----------
API_PORT=3001
# SQLite 数据库文件路径（MVP 默认）
DATABASE_URL=file:./data/oaw.db

# ---------- Gateway (apps/gateway) ----------
GATEWAY_PORT=3002
# WebSocket 路径
WS_PATH=/ws
# 权限请求超时（毫秒），超时按 reject 处理
PERMISSION_TIMEOUT_MS=60000

# ---------- Web (apps/web) ----------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3002/ws

# ---------- Agent ----------
# 默认启用的 Agent id（agent-registry 中定义：mock-agent | claude-code）
DEFAULT_AGENT_ID=mock-agent
# Claude Code ACP 适配器二进制路径（默认使用 @agentclientprotocol/claude-agent-acp）
# CLAUDE_AGENT_ACP_PATH=/path/to/claude-agent-acp
# Codex ACP 适配器（默认 @agentclientprotocol/codex-acp）
# CODEX_ACP_PATH=/path/to/codex-acp
# Gemini CLI 入口（默认 @google/gemini-cli，以 --experimental-acp 启动）
# GEMINI_CLI_PATH=/path/to/gemini.js
# Cursor CLI ACP 适配器（默认 cursor-agent-acp）
# CURSOR_AGENT_ACP_PATH=/path/to/cursor-agent-acp
# 各 Agent 可能需要的密钥（按需填写）
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# CURSOR_API_KEY=

# ---------- 可选：Redis ----------
# MVP 单实例可不配置，仅在需要跨实例共享会话状态时启用
# REDIS_URL=redis://localhost:6379
