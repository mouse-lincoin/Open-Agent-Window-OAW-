{
  "name": "open-agent-window",
  "version": "0.1.0",
  "private": true,
  "description": "Universal ACP Client — Open Agent Window",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "setup": "bash scripts/setup-env.sh",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.18.0"
  }
}
